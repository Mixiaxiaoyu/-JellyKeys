; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="果冻键显 JellyKeys"
run/main_scene="res://scenes/keyboard_overlay.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Jelly Keyboard Overlay"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/app_icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]

window/size/viewport_width=1218
window/size/viewport_height=482
window/size/initial_position_type=2
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/window_width_override=1218
window/size/window_height_override=482
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="JellyKeyboardOverlay"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
viewport/transparent_background=true
